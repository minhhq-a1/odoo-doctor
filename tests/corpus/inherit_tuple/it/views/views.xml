        <field name="extra"/>
        <field name="ghost_proto"/>
      </form>
    </field>
  </record>
  <record id="view_dyn_form" model="ir.ui.view">
    <field name="name">it.dyn.form</field>
    <field name="model">it.dyn</field>
    <field name="arch" type="xml">
      <form>
        <field name="name"/>
        <field name="message_ids"/>
        <field name="ghost_dyn"/>
      </form>
    </field>
  </record>
  <record id="view_unknown_form" model="ir.ui.view">
    <field name="name">it.unknown.form</field>
    <field name="model">it.unknown</field>
    <field name="arch" type="xml">
      <form>
        <field name="name"/>
        <field name="ghost_unknown"/>
      </form>
    </field>
  </record>
</odoo>
