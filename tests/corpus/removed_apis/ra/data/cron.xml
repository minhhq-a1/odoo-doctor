<odoo>
    <data noupdate="1">
    <record id="cron_old" model="ir.cron">
        <field name="name">Old cron</field>
        <field name="model_id" ref="model_ra_legacy"/>
        <field name="state">code</field>
        <field name="code">model.refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>
    <record id="cron_new" model="ir.cron">
        <field name="name">New cron</field>
        <field name="model_id" ref="model_ra_legacy"/>
        <field name="state">code</field>
        <field name="code">model.refresh()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    </data>
</odoo>
