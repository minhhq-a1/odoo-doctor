<odoo>
    <!-- true positives: tree view mode, inline target -->
    <record id="mg_thing_action" model="ir.actions.act_window">
        <field name="name">Things</field>
        <field name="res_model">mg.thing</field>
        <field name="view_mode">tree,form</field>
        <field name="target">inline</field>
    </record>
    <!-- fine -->
    <record id="mg_thing_action_list" model="ir.actions.act_window">
        <field name="name">Things</field>
        <field name="res_model">mg.thing</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
