<odoo>
  <record id="thing_rule" model="ir.rule">
    <field name="name">thing rule</field>
    <field name="model_id" ref="model_shop_thing"/>
    <field name="domain_force">[('create_uid', '=', user.id)]</field>
  </record>
  <record id="ghost_rule" model="ir.rule">
    <field name="name">ghost rule</field>
    <field name="model_id" ref="model_shop_ghost"/>
